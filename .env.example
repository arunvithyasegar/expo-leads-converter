# Anna Incubator ETM 2026 CRM - Local Configuration & Whishper Integration
# All audio processing is 100% local / self-hosted. No external API keys or cloud accounts required.

# Server Port (default 8080 on Windows / 4173)
PORT=8080

# Local Data Root Directory (stores leads.json, recordings/, transcripts/, backups/)
ETM_DATA_DIR=./data

# Local / Self-hosted Whishper Service URL (default local Docker port 8082)
WHISHPER_BASE_URL=http://127.0.0.1:8082

# Local Whishper API Key (leave empty unless your self-hosted Whishper deployment requires authentication)
WHISHPER_API_KEY=
